        `;
        toastContainer.appendChild(toast);

        if (undoCallback) {
          const undoBtn = toast.querySelector('.toast-undo-btn');
          if (undoBtn) {
            undoBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              undoCallback();
              toast.remove();
            });
          }
        }

        requestAnimationFrame(() => {
          toast.classList.remove('opacity-0', 'translate-y-2');
        });

        setTimeout(() => {
          if (toast.parentNode) {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 300);
          }
        }, undoCallback ? 4200 : 2500);
      }

      // Escape HTML to prevent XSS
      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      // Accent palette map for category progress bars and badges
      function getAccentClasses(accent) {
        const map = {
          sky: {
            bar: 'bg-sky-500',
            badge: 'bg-sky-50 text-sky-800 border-sky-200',
            dot: 'bg-sky-400'
          },
          teal: {
            bar: 'bg-teal-500',
            badge: 'bg-teal-50 text-teal-800 border-teal-200',
            dot: 'bg-teal-400'
          },
          rose: {
            bar: 'bg-scarlet-500',
            badge: 'bg-rose-50 text-rose-800 border-rose-200',
            dot: 'bg-rose-400'
          },
          indigo: {
            bar: 'bg-indigo-500',
            badge: 'bg-indigo-50 text-indigo-800 border-indigo-200',
            dot: 'bg-indigo-400'
          },
          emerald: {
            bar: 'bg-emerald-500',
            badge: 'bg-emerald-50 text-emerald-800 border-emerald-200',
            dot: 'bg-emerald-400'
          }
        };
        return map[accent] || map.sky;
      }

      // Populate Category Dropdowns (Add Panel, Mobile Sheet & Edit Modal)
      function syncCategorySelects() {
        const prevAddVal = addItemCategory ? addItemCategory.value : '';
        const prevEditVal = editItemCategory ? editItemCategory.value : '';
        const prevSheetVal = sheetItemCategory ? sheetItemCategory.value : '';

        const optionsHtml = categories
          .map(cat => `<option value="${escapeHtml(cat.id)}">${escapeHtml(cat.title)}</option>`)
          .join('');

        if (addItemCategory) {
          addItemCategory.innerHTML = optionsHtml;
          if (prevAddVal && categories.some(c => c.id === prevAddVal)) addItemCategory.value = prevAddVal;
        }
        if (editItemCategory) {
          editItemCategory.innerHTML = optionsHtml;
          if (prevEditVal && categories.some(c => c.id === prevEditVal)) editItemCategory.value = prevEditVal;
        }
        if (sheetItemCategory) {
          sheetItemCategory.innerHTML = optionsHtml;
          if (prevSheetVal && categories.some(c => c.id === prevSheetVal)) sheetItemCategory.value = prevSheetVal;
        }
      }

      // Update Overall Completion Bar & Category Mini Indicators
      function updateProgressUI() {
        let totalItems = 0;
        let packedItems = 0;
        let totalQuantityUnits = 0;

        categories.forEach(cat => {
          cat.items.forEach(item => {
            totalItems += 1;
            totalQuantityUnits += Number(item.qty) || 1;
            if (item.packed) packedItems += 1;
          });
        });

        const unpackedItems = totalItems - packedItems;
        const pct = totalItems > 0 ? Math.round((packedItems / totalItems) * 100) : 0;

        // Top Main Progress Bar
        overallStatsText.textContent = `${packedItems} / ${totalItems} packed — ${pct}%`;
        overallProgressBar.style.width = `${pct}%`;
        overallProgressAria.setAttribute('aria-valuenow', String(pct));
        totalUnitsPill.textContent = `• ${totalQuantityUnits} total units`;

        // Update Status Badge based on progress percentage
        if (totalItems === 0) {
          statusBadgeText.textContent = 'Manifest Empty';
          statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider bg-white/10 text-slate-300 shrink-0';
        } else if (pct === 0) {
          statusBadgeText.textContent = 'Staging Manifest';
          statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider bg-white/10 text-sky-300 shrink-0';
        } else if (pct < 50) {
          statusBadgeText.textContent = 'Packing Active';
          statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider bg-sky-500/20 text-sky-300 shrink-0';
        } else if (pct < 100) {
          statusBadgeText.textContent = 'Final Checks';
          statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider bg-amber-500/20 text-amber-300 shrink-0';
        } else {
          statusBadgeText.textContent = '100% Ready to Sail';
          statusBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider bg-emerald-500/20 text-emerald-300 shrink-0';
        }

        // Filter Tab Counters (Desktop & Mobile)
        countAllEl.textContent = totalItems;
        countUnpackedEl.textContent = unpackedItems;
        countPackedEl.textContent = packedItems;
        if (mobileCountAllEl) mobileCountAllEl.textContent = totalItems;
        if (mobileCountUnpackedEl) mobileCountUnpackedEl.textContent = unpackedItems;
        if (mobileCountPackedEl) mobileCountPackedEl.textContent = packedItems;

        // Render Horizontally Scrollable Pill Chips on Mobile / Grid on Desktop
        headerMiniCategories.innerHTML = categories.map(cat => {
          const catTotal = cat.items.length;
          const catPacked = cat.items.filter(i => i.packed).length;
          const catPct = catTotal > 0 ? Math.round((catPacked / catTotal) * 100) : 0;
          const accent = getAccentClasses(cat.accent);
          const isComplete = catTotal > 0 && catPacked === catTotal;

          return `
            <button
              type="button"
              data-scroll-cat="${escapeHtml(cat.id)}"
              class="snap-start shrink-0 min-w-[148px] sm:min-w-[164px] lg:min-w-0 min-h-[44px] text-left bg-white/8 hover:bg-white/15 active:scale-95 rounded-xl px-3 py-2 transition border border-white/10 group flex flex-col justify-center"
              title="Jump to ${escapeHtml(cat.title)}"
            >
              <div class="flex items-center justify-between gap-2 text-[11px] mb-1.5">
                <span class="font-semibold text-slate-100 truncate group-hover:text-white">${escapeHtml(cat.title)}</span>
                <span class="font-mono text-[10px] shrink-0 ${isComplete ? 'text-emerald-400 font-bold' : 'text-slate-300'}">
                  ${catPacked}/${catTotal}
                </span>
              </div>
              <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
                <div class="h-full ${isComplete ? 'bg-emerald-400' : accent.bar} transition-all duration-500" style="width: ${catPct}%"></div>
              </div>
            </button>
          `;
        }).join('');
      }

      // Filter an item based on active filter & search query
      function itemMatchesFilter(item, categoryTitle) {
        if (currentFilter === 'unpacked' && item.packed) return false;
        if (currentFilter === 'packed' && !item.packed) return false;

        if (searchQuery.trim() !== '') {
          const q = searchQuery.toLowerCase().trim();
          const inName = item.name.toLowerCase().includes(q);
          const inNote = (item.note || '').toLowerCase().includes(q);
          const inCat = (categoryTitle || '').toLowerCase().includes(q);
          return inName || inNote || inCat;
        }
        return true;
      }

      // Render All Categories & Items
      function renderManifest() {
        updateProgressUI();
        syncCategorySelects();

        let visibleItemCount = 0;

        const cardsHtml = categories.map(cat => {
          const filteredItems = cat.items.filter(item => itemMatchesFilter(item, cat.title));
          visibleItemCount += filteredItems.length;

          // If searching or filtering and this category has 0 matching items, hide the card unless 'all' with empty search
          if (filteredItems.length === 0 && (searchQuery.trim() !== '' || currentFilter !== 'all')) {
            return '';
          }

          const catTotal = cat.items.length;
          const catPacked = cat.items.filter(i => i.packed).length;
          const catPct = catTotal > 0 ? Math.round((catPacked / catTotal) * 100) : 0;
          const isComplete = catTotal > 0 && catPacked === catTotal;
          const accent = getAccentClasses(cat.accent);

          const itemsHtml = filteredItems.length > 0
            ? filteredItems.map(item => {
                const isComplianceHighlight = isItemPortAlert(item);
                return `
                  <li
                    class="group flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3 sm:px-3.5 sm:py-2.5 rounded-xl border transition-all ${
                      item.packed
                        ? 'bg-sand-100/60 border-transparent text-slate-400'
                        : isComplianceHighlight
                          ? 'bg-amber-50/60 border-amber-200/90 hover:border-amber-300'
                          : 'bg-white border-slate-200/80 hover:border-slate-300 shadow-2xs'
                    }"
                    data-cat-id="${escapeHtml(cat.id)}"
                    data-item-id="${escapeHtml(item.id)}"
                  >
                    <!-- Left / Top: 44px+ Touch Target Checkbox + Label + Compliance/Note -->
                    <label class="flex items-start gap-3 flex-1 cursor-pointer select-none min-w-0 min-h-[44px] py-0.5">
                      <input
                        type="checkbox"
                        class="sr-only item-checkbox"
                        data-cat-id="${escapeHtml(cat.id)}"
                        data-item-id="${escapeHtml(item.id)}"
                        ${item.packed ? 'checked' : ''}
                      />
                      <span class="print-checkbox checkbox-bounce mt-0.5 w-6 h-6 rounded-lg flex items-center justify-center border-2 shrink-0 ${
                        item.packed
                          ? 'bg-emerald-600 border-emerald-600 text-white'
                          : 'bg-white border-slate-300 group-hover:border-navy-900'
                      }">
                        ${item.packed ? `
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                          </svg>
                        ` : ''}
                      </span>

                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="item-label-text text-[15px] sm:text-sm font-semibold leading-snug break-words ${
                            item.packed ? 'line-through text-slate-400' : 'text-navy-900'
                          }">
                            ${escapeHtml(item.name)}
                          </span>
                          ${item.qty > 1 ? `
                            <span class="font-mono text-[11px] font-semibold px-1.5 py-0.5 rounded-md ${
                              item.packed
                                ? 'bg-slate-200/70 text-slate-500'
                                : 'bg-navy-900 text-white'
                            }">
                              x${item.qty}
                            </span>
                          ` : ''}
                          ${isComplianceHighlight ? `
                            <span class="font-mono text-[10px] uppercase tracking-wider font-bold px-1.5 py-0.5 rounded bg-amber-200/80 text-amber-950">
                              Port Alert
                            </span>
                          ` : ''}
                        </div>
                        ${item.note ? `
                          <p class="text-xs mt-1 leading-relaxed ${
                            item.packed ? 'text-slate-400/80 line-through' : 'text-slate-500'
                          }">
                            ${escapeHtml(item.note)}
                          </p>
                        ` : ''}
                      </div>
                    </label>

                    <!-- Right / Bottom: Always-Accessible 44x44px Touch Ergonomic Controls (No Print) -->
                    <div class="no-print flex items-center justify-between sm:justify-end gap-1.5 pl-9 sm:pl-0 pt-1 sm:pt-0 border-t sm:border-t-0 border-slate-100 shrink-0">
                      <!-- Quantity Stepper (44x44px buttons) -->
                      <div class="flex items-center bg-sand-100 rounded-xl border border-slate-200/90 p-0.5">
                        <button
                          type="button"
                          data-action="dec-qty"
                          data-cat-id="${escapeHtml(cat.id)}"
                          data-item-id="${escapeHtml(item.id)}"
                          class="w-11 h-11 sm:w-8 sm:h-8 rounded-lg text-slate-700 hover:bg-white active:scale-90 hover:text-navy-900 font-mono text-base sm:text-xs font-bold flex items-center justify-center transition"
                          title="Decrease quantity"
                          aria-label="Decrease quantity"
                        >−</button>
                        <span class="font-mono text-xs font-bold px-2 text-navy-900 min-w-[32px] text-center select-none">
                          x${item.qty}
                        </span>
                        <button
                          type="button"
                          data-action="inc-qty"
                          data-cat-id="${escapeHtml(cat.id)}"
                          data-item-id="${escapeHtml(item.id)}"
                          class="w-11 h-11 sm:w-8 sm:h-8 rounded-lg text-slate-700 hover:bg-white active:scale-90 hover:text-navy-900 font-mono text-base sm:text-xs font-bold flex items-center justify-center transition"
                          title="Increase quantity"
                          aria-label="Increase quantity"
                        >+</button>
                      </div>

                      <div class="flex items-center gap-1">
                        <!-- Edit Item Button (44x44px touch target) -->
                        <button
                          type="button"
                          data-action="edit-item"
                          data-cat-id="${escapeHtml(cat.id)}"
                          data-item-id="${escapeHtml(item.id)}"
                          class="w-11 h-11 sm:w-9 sm:h-9 rounded-xl text-slate-500 hover:text-navy-900 hover:bg-slate-100 active:scale-90 flex items-center justify-center transition"
                          title="Edit item"
                          aria-label="Edit item"
                        >
                          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                          </svg>
                        </button>

                        <!-- Delete Item Button (44x44px touch target) -->
                        <button
                          type="button"
                          data-action="delete-item"
                          data-cat-id="${escapeHtml(cat.id)}"
                          data-item-id="${escapeHtml(item.id)}"
                          class="w-11 h-11 sm:w-9 sm:h-9 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 active:scale-90 flex items-center justify-center transition"
                          title="Delete item"
                          aria-label="Delete item"
                        >
                          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </li>
                `;
              }).join('')
            : `<li class="text-xs text-slate-400 italic py-4 text-center">No items in this category yet. Use the quick-add input below.</li>`;

          return `
            <article
              id="section-${escapeHtml(cat.id)}"
              class="print-card bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden transition-all"
            >
              <!-- Collapsible Accordion Category Header (Full header tappable) -->
              <div
                data-action="toggle-collapse-cat"
                data-cat-id="${escapeHtml(cat.id)}"
                role="button"
                tabindex="0"
                aria-expanded="${!cat.collapsed}"
                class="p-4 sm:p-5 bg-gradient-to-b from-white to-sand-50/60 border-b border-slate-200/80 cursor-pointer select-none active:bg-sand-100/70 transition"
              >
                <div class="flex items-start justify-between gap-2">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h2 class="text-base sm:text-lg font-bold text-navy-900 tracking-tight truncate">
                        ${escapeHtml(cat.title)}
                      </h2>
                      <span class="font-mono text-xs font-semibold px-2.5 py-0.5 rounded-full border ${
                        isComplete
                          ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
                          : accent.badge
                      }">
                        ${catPacked} / ${catTotal} (${catPct}%)
                      </span>
                    </div>
                    ${cat.subtitle ? `<p class="text-xs text-slate-500 mt-0.5">${escapeHtml(cat.subtitle)}</p>` : ''}
                  </div>

                  <!-- Category Header Controls (No Print) -->
                  <div class="no-print flex items-center gap-1 shrink-0">
                    ${catPacked < catTotal ? `
                      <button
                        type="button"
                        data-action="check-all-cat"
                        data-cat-id="${escapeHtml(cat.id)}"
                        class="min-h-[44px] px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 bg-sand-100/80 hover:bg-slate-200/70 hover:text-navy-900 active:scale-95 transition"
                        title="Mark entire category packed"
                      >
                        Pack All
                      </button>
                    ` : `
                      <button
                        type="button"
                        data-action="uncheck-all-cat"
                        data-cat-id="${escapeHtml(cat.id)}"
                        class="min-h-[44px] px-3 py-1.5 rounded-xl text-xs font-semibold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 active:scale-95 transition"
                        title="Unpack category"
                      >
                        Unpack
                      </button>
                    `}
                    <span
                      class="w-11 h-11 rounded-xl text-slate-500 flex items-center justify-center transition pointer-events-none"
                      title="${cat.collapsed ? 'Expand category' : 'Collapse category'}"
                    >
                      <svg class="w-5 h-5 transform transition-transform duration-200 ${cat.collapsed ? '-rotate-90' : 'rotate-0'}" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </span>
                  </div>
                </div>

                <!-- Mini Category Progress Bar -->
                <div class="mt-3 w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                  <div
                    class="progress-fill h-full rounded-full ${isComplete ? 'bg-emerald-500' : accent.bar}"
                    style="width: ${catPct}%"
                  ></div>
                </div>
              </div>

              <!-- Category Body (Items + Inline Quick-Add) -->
              <div class="${cat.collapsed ? 'hidden' : 'block'} p-3 sm:p-4 space-y-3">
                <ul class="space-y-2.5">
                  ${itemsHtml}
                </ul>

                <!-- Inline Quick-Add Item Form inside Category (16px font on mobile, 44px height) -->
                <form class="no-print quick-add-form pt-2.5 border-t border-slate-100 flex items-center gap-2" data-cat-id="${escapeHtml(cat.id)}">
                  <input
                    type="text"
                    name="quickName"
                    required
                    placeholder="+ Add item to ${escapeHtml(cat.title)}..."
                    class="flex-1 min-h-[44px] px-3.5 py-2 bg-sand-50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-base sm:text-sm text-navy-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-ocean-500 transition"
                  />
                  <input
                    type="number"
                    name="quickQty"
                    min="1"
                    max="99"
                    value="1"
                    class="w-16 min-h-[44px] px-2 py-2 bg-sand-50 focus:bg-white border border-slate-200 rounded-xl text-base sm:text-xs font-mono text-center focus:outline-none focus:ring-2 focus:ring-ocean-500"
                    title="Quantity"
                  />
                  <button
                    type="submit"
                    class="min-h-[44px] px-4 py-2 rounded-xl bg-navy-900 hover:bg-navy-800 active:scale-95 text-white text-xs sm:text-sm font-semibold transition shrink-0"
                  >
                    Add
                  </button>
                </form>
              </div>
            </article>
          `;
        }).join('');

        categoriesContainer.innerHTML = cardsHtml;

        // Show or Hide Empty State
        if (visibleItemCount === 0 && (searchQuery.trim() !== '' || currentFilter !== 'all')) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }

        // Update Expand/Collapse button text on Desktop, Mobile Header & Mobile Sheet
        const allCollapsed = categories.length > 0 && categories.every(c => c.collapsed);
        expandCollapseLabel.textContent = allCollapsed ? 'Expand All' : 'Collapse All';
        if (mobileExpandCollapseLabel) {
          mobileExpandCollapseLabel.textContent = allCollapsed ? 'Unfold All' : 'Fold All';
        }
        if (sheetExpandCollapseText) {
          sheetExpandCollapseText.textContent = allCollapsed ? 'Expand All Categories' : 'Collapse All Categories';
        }
      }

      // Event Delegation for Category Container (Qty Steppers, Edit, Delete, Collapse, Pack All)
      categoriesContainer.addEventListener('click', (e) => {
        const actionBtn = e.target.closest('[data-action]');
        if (!actionBtn) return;

        // Prevent bubbling so buttons inside rows or category headers never trigger parent handlers
        e.stopPropagation();

        const action = actionBtn.getAttribute('data-action');
        const catId = actionBtn.getAttribute('data-cat-id');
        const itemId = actionBtn.getAttribute('data-item-id');

        const category = categories.find(c => c.id === catId);
        if (!category) return;

        if (action === 'toggle-collapse-cat') {
          category.collapsed = !category.collapsed;
          saveState();
          renderManifest();
          return;
        }

        if (action === 'check-all-cat') {
          e.preventDefault();
          category.items.forEach(i => { i.packed = true; });
          saveState();
          renderManifest();
          showToast(`Packed all items in ${category.title}`);
          return;
        }

        if (action === 'uncheck-all-cat') {
          e.preventDefault();
          category.items.forEach(i => { i.packed = false; });
          saveState();
          renderManifest();
          showToast(`Unpacked items in ${category.title}`);
          return;
        }

        const itemIndex = category.items.findIndex(i => i.id === itemId);
        if (itemIndex === -1) return;
        const item = category.items[itemIndex];

        if (action === 'inc-qty') {
          e.preventDefault();
          item.qty = Math.min(99, (Number(item.qty) || 1) + 1);
          saveState();
          renderManifest();
        } else if (action === 'dec-qty') {
          e.preventDefault();
          item.qty = Math.max(1, (Number(item.qty) || 1) - 1);
          saveState();
          renderManifest();
        } else if (action === 'delete-item') {
          e.preventDefault();
          const removedItem = { ...item };
          const removedCatId = category.id;
          const removedIdx = itemIndex;
          category.items.splice(itemIndex, 1);
          saveState();
          renderManifest();
          showToast(`Removed "${removedItem.name}"`, () => {
            const targetCat = categories.find(c => c.id === removedCatId);
            if (targetCat) {
              targetCat.items.splice(Math.min(removedIdx, targetCat.items.length), 0, removedItem);
              saveState();
              renderManifest();
              showToast(`Restored "${removedItem.name}"`);
            }
          });
        } else if (action === 'edit-item') {
          e.preventDefault();
          openEditModal(catId, item);
        }
      });

      // Keyboard Accessibility for Accordion Headers (Enter / Space)
      categoriesContainer.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const headerEl = e.target.closest('[data-action="toggle-collapse-cat"]');
        if (!headerEl || e.target.closest('button, input')) return;
        e.preventDefault();
        const catId = headerEl.getAttribute('data-cat-id');
        const category = categories.find(c => c.id === catId);
        if (category) {
          category.collapsed = !category.collapsed;
          saveState();
          renderManifest();
        }
      });

      // Checkbox change handler
      categoriesContainer.addEventListener('change', (e) => {
        const checkbox = e.target.closest('.item-checkbox');
        if (!checkbox) return;

        e.stopPropagation();
        const catId = checkbox.getAttribute('data-cat-id');
        const itemId = checkbox.getAttribute('data-item-id');
        const category = categories.find(c => c.id === catId);
        if (!category) return;
        const item = category.items.find(i => i.id === itemId);
        if (!item) return;

        item.packed = checkbox.checked;
        saveState();
        renderManifest();
      });

      // Inline Quick-Add Form submit inside any category card
      categoriesContainer.addEventListener('submit', (e) => {
        const form = e.target.closest('.quick-add-form');
        if (!form) return;
        e.preventDefault();
        e.stopPropagation();

        const catId = form.getAttribute('data-cat-id');
        const category = categories.find(c => c.id === catId);
        if (!category) return;

        const nameInput = form.querySelector('input[name="quickName"]');
        const qtyInput = form.querySelector('input[name="quickQty"]');
        const name = nameInput.value.trim();
        const qty = Math.max(1, Math.min(99, parseInt(qtyInput.value, 10) || 1));

        if (!name) return;

        category.collapsed = false;
        category.items.push({
          id: 'item-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
          name,
          qty,
          packed: false,
          portAlert: name.toLowerCase().includes('camouflage') || name.toLowerCase().includes('non-surge'),
          note: ''
        });

        nameInput.value = '';
        qtyInput.value = '1';

        saveState();
        renderManifest();
        showToast(`Added "${name}" to ${category.title}`);
      });

      // Jump to Category when clicking header mini progress pill
      headerMiniCategories.addEventListener('click', (e) => {
        const pill = e.target.closest('[data-scroll-cat]');
        if (!pill) return;
        const catId = pill.getAttribute('data-scroll-cat');
        const category = categories.find(c => c.id === catId);
        if (category && category.collapsed) {
          category.collapsed = false;
          saveState();
          renderManifest();
        }
        const targetEl = document.getElementById('section-' + catId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });

      // Filter View Buttons (Synchronizes both Desktop & Mobile Thumb-Zone Filter Bars)
      function setFilterView(newFilter) {
        currentFilter = newFilter;
        filterButtons.forEach(b => {
          const active = b.getAttribute('data-filter') === currentFilter;
          const isMobileNav = b.closest('nav') !== null;
          if (isMobileNav) {
            b.className = active
              ? 'filter-btn min-h-[44px] flex-1 px-2 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1 bg-navy-900 text-white shadow-2xs active:scale-95'
              : 'filter-btn min-h-[44px] flex-1 px-2 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1 text-slate-600 active:scale-95';
          } else {
            b.className = active
              ? 'filter-btn min-h-[40px] flex-1 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 bg-navy-900 text-white shadow-xs active:scale-95'
              : 'filter-btn min-h-[40px] flex-1 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-navy-900 active:scale-95';
          }
        });
        renderManifest();
      }

      filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          setFilterView(btn.getAttribute('data-filter'));
        });
      });

      // Search Input
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        clearSearchBtn.classList.toggle('hidden', searchQuery.trim() === '');
        renderManifest();
      });

      clearSearchBtn.addEventListener('click', (e) => {
        e.preventDefault();
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        renderManifest();
        searchInput.focus();
      });

      // Reset Filters Button (from Empty State)
      btnResetFilters.addEventListener('click', (e) => {
        e.preventDefault();
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.classList.add('hidden');
        setFilterView('all');
      });

      // Toggle Top Add Item/Category Panel (Desktop)
      btnToggleAddPanel.addEventListener('click', (e) => {
        e.preventDefault();
        const isHidden = addPanel.classList.contains('hidden');
        addPanel.classList.toggle('hidden');
        if (isHidden) {
          addItemName.focus();
        }
      });

      // Mobile Quick-Add Bottom Sheet Logic
      function openMobileAddSheet() {
        syncCategorySelects();
        mobileAddSheet.classList.remove('hidden');
        mobileAddSheet.classList.add('flex');
        setTimeout(() => sheetItemName.focus(), 50);
      }

      function closeMobileAddSheet() {
        mobileAddSheet.classList.add('hidden');
        mobileAddSheet.classList.remove('flex');
      }

      btnMobileQuickAdd.addEventListener('click', openMobileAddSheet);
      mobileAddSheetClose.addEventListener('click', closeMobileAddSheet);
      mobileAddSheet.addEventListener('click', (e) => {
        if (e.target === mobileAddSheet) closeMobileAddSheet();
      });

      formSheetAddItem.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = sheetItemName.value.trim();
        const catId = sheetItemCategory.value;
        const qty = Math.max(1, Math.min(99, parseInt(sheetItemQty.value, 10) || 1));
        const note = sheetItemNote.value.trim();
        const portAlert = sheetItemAlert ? sheetItemAlert.checked : false;

        if (!name) return;
        const category = categories.find(c => c.id === catId) || categories[0];
        if (!category) return;

        category.collapsed = false;
        category.items.push({
          id: 'item-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
          name,
          qty,
          packed: false,
          portAlert,
          note
        });

        sheetItemName.value = '';
        sheetItemQty.value = '1';
        sheetItemNote.value = '';
        if (sheetItemAlert) sheetItemAlert.checked = false;

        saveState();
        renderManifest();
        closeMobileAddSheet();
        showToast(`Added "${name}" to ${category.title}`);
      });

      formSheetAddCategory.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = sheetCategoryTitle.value.trim();
        if (!title) return;

        const accents = ['sky', 'teal', 'rose', 'indigo', 'emerald'];
        const accent = accents[categories.length % accents.length];

        const newCat = {
          id: 'cat-' + Date.now(),
          title,
          subtitle: 'Custom packing category',
          accent,
          collapsed: false,
          items: []
        };

        categories.push(newCat);
        sheetCategoryTitle.value = '';
        saveState();
        renderManifest();
        sheetItemCategory.value = newCat.id;
        showToast(`Created category "${title}"`);
      });

      // Mobile More Actions Bottom Sheet Logic
      function openMobileActionsSheet() {
        mobileActionsSheet.classList.remove('hidden');
        mobileActionsSheet.classList.add('flex');
      }

      function closeMobileActionsSheet() {
        mobileActionsSheet.classList.add('hidden');
        mobileActionsSheet.classList.remove('flex');
      }

      btnMobileMore.addEventListener('click', openMobileActionsSheet);
      mobileActionsClose.addEventListener('click', closeMobileActionsSheet);
      mobileActionsSheet.addEventListener('click', (e) => {
        if (e.target === mobileActionsSheet) closeMobileActionsSheet();
      });

      // Top Form: Add New Item (Desktop)
      formAddItem.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = addItemName.value.trim();
        const catId = addItemCategory.value;
        const qty = Math.max(1, Math.min(99, parseInt(addItemQty.value, 10) || 1));
        const note = addItemNote.value.trim();
        const portAlert = addItemAlert ? addItemAlert.checked : false;

        if (!name) return;
        const category = categories.find(c => c.id === catId) || categories[0];
        if (!category) return;

        category.collapsed = false;
        category.items.push({
          id: 'item-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6),
          name,
          qty,
          packed: false,
          portAlert,
          note
        });

        addItemName.value = '';
        addItemQty.value = '1';
        addItemNote.value = '';
        if (addItemAlert) addItemAlert.checked = false;

        saveState();
        renderManifest();
        showToast(`Added "${name}" to ${category.title}`);
      });

      // Top Form: Create New Category (Desktop)
      formAddCategory.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = addCategoryTitle.value.trim();
        if (!title) return;

        const accents = ['sky', 'teal', 'rose', 'indigo', 'emerald'];
        const accent = accents[categories.length % accents.length];

        const newCat = {
          id: 'cat-' + Date.now(),
          title,
          subtitle: 'Custom packing category',
          accent,
          collapsed: false,
          items: []
        };

        categories.push(newCat);
        addCategoryTitle.value = '';
        saveState();
        renderManifest();
        addItemCategory.value = newCat.id;
        showToast(`Created category "${title}"`);
      });

      // Expand / Collapse All Categories (Desktop, Mobile Header, and Mobile Sheet)
      function toggleAllCategoriesAccordion() {
        const allCollapsed = categories.length > 0 && categories.every(c => c.collapsed);
        categories.forEach(c => { c.collapsed = !allCollapsed; });
        saveState();
        renderManifest();
        showToast(allCollapsed ? 'Expanded all categories' : 'Folded all categories');
      }

      btnExpandCollapse.addEventListener('click', toggleAllCategoriesAccordion);
      btnMobileExpandCollapse.addEventListener('click', toggleAllCategoriesAccordion);
      sheetBtnExpandCollapse.addEventListener('click', () => {
        toggleAllCategoriesAccordion();
        closeMobileActionsSheet();
      });

      // Print Manifest
      function triggerPrintManifest() {
        categories.forEach(c => { c.collapsed = false; });
        renderManifest();
        showToast('Preparing print-ready manifest...');
        setTimeout(() => window.print(), 150);
      }

      btnPrint.addEventListener('click', triggerPrintManifest);
      sheetBtnPrint.addEventListener('click', () => {
        closeMobileActionsSheet();
        triggerPrintManifest();
      });

      // Confirmation Modal Helpers
      function openConfirmModal(title, description, onConfirm) {
        modalTitle.textContent = title;
        modalDescription.textContent = description;
        pendingConfirmAction = onConfirm;
        confirmModal.classList.remove('hidden');
        confirmModal.classList.add('flex');
      }

      function closeConfirmModal() {
        confirmModal.classList.add('hidden');
        confirmModal.classList.remove('flex');
        pendingConfirmAction = null;
      }

      modalCancelBtn.addEventListener('click', closeConfirmModal);
      confirmModal.addEventListener('click', (e) => {
        if (e.target === confirmModal) closeConfirmModal();
      });

      modalConfirmBtn.addEventListener('click', () => {
        if (typeof pendingConfirmAction === 'function') {
          pendingConfirmAction();
        }
        closeConfirmModal();
      });

      // Check All Items (Mark 100% Packed)
      function promptCheckAll() {
        openConfirmModal(
          'Mark All Items as Packed?',
          'This will check off every item across all categories in your manifest as packed (100% completion).',
          () => {
            categories.forEach(cat => {
              cat.items.forEach(item => { item.packed = true; });
            });
            saveState();
            renderManifest();
            showToast('All manifest items marked as packed (100%)');
          }
        );
      }

      if (btnCheckAll) btnCheckAll.addEventListener('click', promptCheckAll);
      if (sheetBtnCheckAll) {
        sheetBtnCheckAll.addEventListener('click', () => {
          closeMobileActionsSheet();
          promptCheckAll();
        });
      }

      // Uncheck All (Reset for Next Trip)
      function promptUncheckAll() {
        openConfirmModal(
          'Uncheck All Packed Items?',
          'This will reset all checkmarks back to unpacked for your next trip while keeping all your custom items, notes, and quantities intact.',
          () => {
            categories.forEach(cat => {
              cat.items.forEach(item => { item.packed = false; });
            });
            saveState();
            renderManifest();
            showToast('All items unchecked for next voyage');
          }
        );
      }

      btnUncheckAll.addEventListener('click', promptUncheckAll);
      sheetBtnUncheck.addEventListener('click', () => {
        closeMobileActionsSheet();
        promptUncheckAll();
      });

      // Restore Pre-loaded Defaults
      function promptRestoreDefaults() {
        openConfirmModal(
          'Restore Default Packing Manifest?',
          'This will restore the original pre-loaded tropical & cruise categories and remove any custom items or edits you have made.',
          () => {
            categories = cloneDefaults();
            saveState();
            renderManifest();
            showToast('Restored default cruise & port manifest');
          }
        );
      }

      btnRestoreDefaults.addEventListener('click', promptRestoreDefaults);
      sheetBtnRestore.addEventListener('click', () => {
        closeMobileActionsSheet();
        promptRestoreDefaults();
      });

      // Edit Item Modal Logic
      function openEditModal(catId, item) {
        syncCategorySelects();
        editCatId.value = catId;
        editItemId.value = item.id;
        editItemName.value = item.name;
        editItemQty.value = item.qty || 1;
        editItemCategory.value = catId;
        editItemNote.value = item.note || '';
        if (editItemAlert) {
          editItemAlert.checked = isItemPortAlert(item);
        }

        editModal.classList.remove('hidden');
        editModal.classList.add('flex');
        setTimeout(() => editItemName.focus(), 50);
      }

      function closeEditModal() {
        editModal.classList.add('hidden');
        editModal.classList.remove('flex');
      }

      editModalClose.addEventListener('click', closeEditModal);
      editCancelBtn.addEventListener('click', closeEditModal);
      editModal.addEventListener('click', (e) => {
        if (e.target === editModal) closeEditModal();
      });

      formEditItem.addEventListener('submit', (e) => {
        e.preventDefault();
        const origCatId = editCatId.value;
        const targetCatId = editItemCategory.value;
        const itemId = editItemId.value;

        const origCategory = categories.find(c => c.id === origCatId);
        if (!origCategory) return;

        const itemIdx = origCategory.items.findIndex(i => i.id === itemId);
        if (itemIdx === -1) return;

        const updatedItem = {
          ...origCategory.items[itemIdx],
          name: editItemName.value.trim() || origCategory.items[itemIdx].name,
          qty: Math.max(1, Math.min(99, parseInt(editItemQty.value, 10) || 1)),
          note: editItemNote.value.trim(),
          portAlert: editItemAlert ? editItemAlert.checked : isItemPortAlert(origCategory.items[itemIdx])
        };

        if (origCatId === targetCatId) {
          origCategory.items[itemIdx] = updatedItem;
        } else {
          origCategory.items.splice(itemIdx, 1);
          const targetCategory = categories.find(c => c.id === targetCatId);
          if (targetCategory) {
            targetCategory.collapsed = false;
            targetCategory.items.push(updatedItem);
          }
        }

        saveState();
        renderManifest();
        closeEditModal();
        showToast(`Updated "${updatedItem.name}"`);
      });

      // Generate High-Resolution 180x180 PNG Home Screen Icon & Dynamic Web App Manifest
      let deferredInstallPrompt = null;

      function hydratePwaIconAndManifest() {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = 180;
          canvas.height = 180;
          const ctx = canvas.getContext('2d');
          if (!ctx) return;

          // Deep Nautical Navy Rounded Background
          ctx.fillStyle = '#091526';
          ctx.beginPath();
          ctx.roundRect ? ctx.roundRect(0, 0, 180, 180, 40) : ctx.rect(0, 0, 180, 180);
          ctx.fill();

          // Subtle Inner Border Ring
          ctx.strokeStyle = 'rgba(255,255,255,0.12)';
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(90, 90, 70, 0, Math.PI * 2);
          ctx.stroke();

          // Scarlet Compass Outer Ring
          ctx.strokeStyle = '#E11D48';
          ctx.lineWidth = 10;
          ctx.beginPath();
          ctx.arc(90, 90, 52, 0, Math.PI * 2);
          ctx.stroke();

          // Compass Cardinal Ticks
          ctx.strokeStyle = '#FAF9F5';
          ctx.lineWidth = 4;
          [[90, 26, 90, 36], [90, 144, 90, 154], [26, 90, 36, 90], [144, 90, 154, 90]].forEach(([x1, y1, x2, y2]) => {
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();
          });

          // Compass Needle (Sky Blue & Warm Sand)
          ctx.fillStyle = '#38BDF8';
          ctx.beginPath();
          ctx.moveTo(118, 62);
          ctx.lineTo(100, 100);
          ctx.lineTo(80, 80);
          ctx.closePath();
          ctx.fill();

          ctx.fillStyle = '#FAF9F5';
          ctx.beginPath();
          ctx.moveTo(62, 118);
          ctx.lineTo(100, 100);
          ctx.lineTo(80, 80);
          ctx.closePath();
          ctx.fill();

          // Center Pivot Dot
          ctx.fillStyle = '#091526';
          ctx.beginPath();
          ctx.arc(90, 90, 6, 0, Math.PI * 2);
          ctx.fill();

          const pngDataUrl = canvas.toDataURL('image/png');
          const appleIconEl = document.getElementById('apple-touch-icon-link');
          const faviconEl = document.getElementById('favicon-link');
          if (appleIconEl) appleIconEl.href = pngDataUrl;
          if (faviconEl) {
            faviconEl.type = 'image/png';
            faviconEl.href = pngDataUrl;
          }
          if (installModalIconPreview) {
            installModalIconPreview.src = pngDataUrl;
          }

          // Inject Inline Web App Manifest for Android / Chrome / Modern Safari PWA support
          const manifestObj = {
            name: 'Voyage & Port Packing Manifest',
            short_name: 'Voyage Manifest',
            description: 'Interactive cruise and tropical port packing checklist with completion bar.',
            start_url: '.',
            display: 'standalone',
            background_color: '#FAF9F5',
            theme_color: '#0f172a',
            icons: [
              { src: pngDataUrl, sizes: '180x180', type: 'image/png', purpose: 'any maskable' },
              { src: pngDataUrl, sizes: '512x512', type: 'image/png', purpose: 'any maskable' }
            ]
          };
          const manifestBlob = new Blob([JSON.stringify(manifestObj)], { type: 'application/manifest+json' });
          const manifestUrl = URL.createObjectURL(manifestBlob);
          const manifestLink = document.getElementById('pwa-manifest-link');
          if (manifestLink) manifestLink.href = manifestUrl;
        } catch (err) {
          console.warn('PWA icon canvas generation skipped:', err);
        }
      }

      // Listen for native beforeinstallprompt (Android Chrome / Desktop Edge/Chrome)
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        if (btnNativePwaPrompt) {
          btnNativePwaPrompt.classList.remove('hidden');
          btnNativePwaPrompt.classList.add('flex');
        }
      });

      if (btnNativePwaPrompt) {
        btnNativePwaPrompt.addEventListener('click', async () => {
          if (!deferredInstallPrompt) return;
          deferredInstallPrompt.prompt();
          await deferredInstallPrompt.userChoice;
          deferredInstallPrompt = null;
          btnNativePwaPrompt.classList.add('hidden');
        });
      }

      // Open / Close "Install / Save App to Phone" Modal
      function openInstallModal() {
        if (!installModal) return;
        installModal.classList.remove('hidden');
        installModal.classList.add('flex');
      }

      function closeInstallModal() {
        if (!installModal) return;
        installModal.classList.add('hidden');
        installModal.classList.remove('flex');
      }

      if (btnInstallApp) btnInstallApp.addEventListener('click', openInstallModal);
      if (btnMobileInstallHeader) btnMobileInstallHeader.addEventListener('click', openInstallModal);
      if (btnFooterInstall) btnFooterInstall.addEventListener('click', openInstallModal);
      if (sheetBtnInstall) {
        sheetBtnInstall.addEventListener('click', () => {
          closeMobileActionsSheet();
          openInstallModal();
        });
      }
      if (installModalClose) installModalClose.addEventListener('click', closeInstallModal);
      if (installModalDone) installModalDone.addEventListener('click', closeInstallModal);
      if (installModal) {
        installModal.addEventListener('click', (e) => {
          if (e.target === installModal) closeInstallModal();
        });
      }

      // Download Self-Contained Standalone HTML File for Local Phone Saving or Hosting
      function downloadStandaloneHtmlFile() {
        try {
          const htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
          const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'voyage-packing-manifest.html';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 1500);
          showToast('Downloaded voyage-packing-manifest.html');
        } catch (err) {
          console.error('Download failed:', err);
          showToast('Unable to trigger download in this preview frame');
        }
      }

      if (btnDownloadHtml) {
        btnDownloadHtml.addEventListener('click', downloadStandaloneHtmlFile);
      }

      // Interactive Button & Event Handler Self-Test Diagnostics Suite
      function runButtonDiagnostics(silentOnLoad) {
        const requiredElements = [
          'overall-progress-bar',
          'header-mini-categories',
          'categories-container',
          'search-input',
          'clear-search-btn',
          'btn-toggle-add-panel',
          'form-add-item',
          'form-add-category',
          'btn-install-app',
          'btn-mobile-install-header',
          'install-modal',
          'btn-download-html',
          'btn-expand-collapse',
          'btn-mobile-expand-collapse',
          'btn-print',
          'btn-check-all',
          'btn-uncheck-all',
          'btn-restore-defaults',
          'btn-mobile-quick-add',
          'btn-mobile-more',
          'confirm-modal',
          'edit-modal'
        ];

        const missing = requiredElements.filter(id => !document.getElementById(id));
        const stepperCount = document.querySelectorAll('[data-action="inc-qty"], [data-action="dec-qty"]').length;
        const editDeleteCount = document.querySelectorAll('[data-action="edit-item"], [data-action="delete-item"]').length;
        const filterBtnCount = document.querySelectorAll('.filter-btn').length;
        const quickAddCount = document.querySelectorAll('.quick-add-form').length;

        const isHealthy = missing.length === 0 && filterBtnCount === 6 && categories.length > 0;

        if (diagnosticsBadgeLabel) {
          diagnosticsBadgeLabel.textContent = isHealthy
            ? `Self-Test: 100% OK (${stepperCount + editDeleteCount + filterBtnCount} controls)`
            : `Self-Test: Check ${missing.length} issue(s)`;
        }

        if (!silentOnLoad) {
          showToast(
            isHealthy
              ? `Diagnostics Passed: ${categories.length} categories, ${quickAddCount} quick-add forms, ${stepperCount} steppers & ${filterBtnCount} filters verified.`
              : `Diagnostics Alert: Missing ${missing.join(', ')}`
          );
        }
      }

      if (btnRunDiagnostics) {
        btnRunDiagnostics.addEventListener('click', () => runButtonDiagnostics(false));
      }
      if (btnFooterDiagnostics) {
        btnFooterDiagnostics.addEventListener('click', () => runButtonDiagnostics(false));
      }
      if (sheetBtnDiagnostics) {
        sheetBtnDiagnostics.addEventListener('click', () => {
          closeMobileActionsSheet();
          runButtonDiagnostics(false);
        });
      }

      // Escape key closes active modal
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeConfirmModal();
          closeEditModal();
          closeMobileAddSheet();
          closeMobileActionsSheet();
          closeInstallModal();
        }
      });

      // Initialize Application
      loadState();
      hydratePwaIconAndManifest();
      renderManifest();
      runButtonDiagnostics(true);
    })();
  </script>
</body>
</html>

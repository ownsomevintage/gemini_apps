<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Voyage & Port — Interactive Packing Manifest</title>

  <!-- iOS & Android Standalone Full-Screen Web App (PWA) Meta Tags -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Voyage Manifest" />
  <meta name="application-name" content="Voyage Manifest" />
  <meta name="theme-color" content="#0f172a" />

  <!-- Fallback SVG Icon & Dynamic Canvas PNG Icon / Manifest Links (Hydrated on Load) -->
  <link id="apple-touch-icon-link" rel="apple-touch-icon" sizes="180x180" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' rx='40' fill='%23091526'/%3E%3Ccircle cx='90' cy='90' r='58' fill='none' stroke='%23E11D48' stroke-width='10'/%3E%3Cpolygon points='116,64 102,102 64,116 78,78' fill='%2338BDF8'/%3E%3C/svg%3E" />
  <link id="favicon-link" rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' rx='40' fill='%23091526'/%3E%3Ccircle cx='90' cy='90' r='58' fill='none' stroke='%23E11D48' stroke-width='10'/%3E%3Cpolygon points='116,64 102,102 64,116 78,78' fill='%2338BDF8'/%3E%3C/svg%3E" />
  <link id="pwa-manifest-link" rel="manifest" href="" />

  <!-- Load Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono for crisp editorial & technical aesthetic -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            navy: {
              800: '#102338',
              900: '#091526',
              950: '#050C16',
            },
            scarlet: {
              500: '#E11D48',
              600: '#BE123C',
            },
            ocean: {
              500: '#0284C7',
              600: '#0369A1',
            },
            sand: {
              50: '#FAF9F5',
              100: '#F3F1E9',
              200: '#E6E2D6',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #FAF9F5;
      color: #091526;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    button, a, input, select, textarea, label {
      touch-action: manipulation;
    }

    /* Hide scrollbar for horizontal pill carousels on mobile */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Safe area padding for iPhone Notch / Dynamic Island & Home Indicator */
    .pt-safe-top {
      padding-top: env(safe-area-inset-top, 0px);
    }
    .sticky-safe-top {
      top: 0;
      padding-top: max(0.5rem, env(safe-area-inset-top, 0px));
    }
    .px-safe {
      padding-left: max(0.75rem, env(safe-area-inset-left, 0px));
      padding-right: max(0.75rem, env(safe-area-inset-right, 0px));
    }
    .pb-safe {
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    }
    .pb-sheet-safe {
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));
    }

    /* Standalone PWA Mode Enhancements */
    @media all and (display-mode: standalone) {
      .pwa-standalone-badge {
        display: inline-flex !important;
      }
    }

    /* Smooth custom checkbox & strikethrough animations */
    .item-label-text {
      position: relative;
      transition: color 0.2s ease;
    }
    
    .checkbox-bounce {
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.15s ease, border-color 0.15s ease;
    }
    .checkbox-bounce:active {
      transform: scale(0.86);
    }

    /* Progress bar shimmer effect */
    @keyframes progressPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.85; }
    }
    .progress-fill {
      transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.3s ease;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F3F1E9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }

    /* Print-friendly Overrides */
    @media print {
      body {
        background-color: #FFFFFF !important;
        color: #000000 !important;
        font-size: 11pt;
        padding-bottom: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      .print-card {
        break-inside: avoid;
        page-break-inside: avoid;
        border: 1px solid #000000 !important;
        box-shadow: none !important;
        margin-bottom: 16px !important;
        background: #FFFFFF !important;
      }
      .print-grid {
        display: block !important;
      }
      .sticky-dashboard {
        position: static !important;
        box-shadow: none !important;
        border-bottom: 2px solid #000000 !important;
      }
      .print-checkbox {
        border: 1.5px solid #000 !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col pb-24 md:pb-8 selection:bg-scarlet-500 selection:text-white">

  <!-- Non-Sticky Editorial Title & Desktop Utility Bar (Includes iPhone Notch Safe-Area Top Padding) -->
  <div class="bg-sand-50 border-b border-slate-200/70 pt-safe-top">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3.5 pb-3 sm:py-4 px-safe">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5 sm:gap-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-navy-900 text-white flex items-center justify-center shrink-0 shadow-sm">
              <!-- Compass / Ship Wheel SVG -->
              <svg class="w-5 h-5 text-scarlet-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h1 class="text-base sm:text-2xl font-extrabold tracking-tight text-navy-900 leading-tight">
                  VOYAGE &amp; PORT MANIFEST
                </h1>
                <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-widest px-2 py-0.5 rounded-full bg-scarlet-500/10 text-scarlet-600 font-semibold border border-scarlet-500/20">
                  Cruise Edition
                </span>
                <span class="pwa-standalone-badge hidden text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 font-semibold border border-emerald-500/30">
                  App Mode
                </span>
              </div>
              <p class="hidden sm:block text-xs sm:text-sm text-slate-600 mt-0.5">
                Smart interactive checklist with port compliance, tech/sketch kit &amp; excursion readiness
              </p>
            </div>
          </div>

          <!-- Mobile Quick Install & Fold Buttons -->
          <div class="no-print md:hidden flex items-center gap-1.5 shrink-0">
            <button id="btn-mobile-install-header" type="button" class="min-h-[44px] px-2.5 rounded-xl border border-ocean-500/30 bg-ocean-500/10 active:scale-95 text-xs font-semibold text-ocean-600 flex items-center gap-1 shadow-2xs" title="Save App Icon to Phone">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
              <span>App Icon</span>
            </button>
            <button id="btn-mobile-expand-collapse" type="button" class="min-h-[44px] px-3 rounded-xl border border-slate-300 bg-white active:scale-95 text-xs font-semibold text-navy-900 flex items-center gap-1.5 shadow-2xs">
              <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
              </svg>
              <span id="mobile-expand-collapse-label">Fold All</span>
            </button>
          </div>
        </div>

        <!-- Desktop Utility Actions (Hidden on Mobile, moved to Thumb-Zone Bottom Sheet) -->
        <div class="no-print hidden md:flex flex-wrap items-center gap-2">
          <button id="btn-install-app" type="button" class="min-h-[40px] text-xs font-semibold px-3.5 py-2 rounded-xl border border-ocean-500/30 bg-ocean-500/10 hover:bg-ocean-500/20 active:scale-95 text-ocean-600 transition flex items-center gap-1.5 shadow-2xs" title="Save App Icon to Phone or Download HTML">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
            <span>Install / Phone Icon</span>
          </button>

          <button id="btn-expand-collapse" type="button" class="min-h-[40px] text-xs font-medium px-3.5 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 active:scale-95 text-slate-700 transition flex items-center gap-1.5 shadow-2xs">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
            </svg>
            <span id="expand-collapse-label">Collapse All</span>
          </button>

          <button id="btn-print" type="button" class="min-h-[40px] text-xs font-medium px-3.5 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 active:scale-95 text-slate-700 transition flex items-center gap-1.5 shadow-2xs" title="Print Checklist">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
            <span>Print</span>
          </button>

          <button id="btn-check-all" type="button" class="min-h-[40px] text-xs font-medium px-3.5 py-2 rounded-xl border border-emerald-300 bg-emerald-50 hover:bg-emerald-100 active:scale-95 text-emerald-900 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Check All</span>
          </button>

          <button id="btn-uncheck-all" type="button" class="min-h-[40px] text-xs font-medium px-3.5 py-2 rounded-xl border border-amber-300 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-900 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            <span>Uncheck All</span>
          </button>

          <button id="btn-restore-defaults" type="button" class="min-h-[40px] text-xs font-medium px-3.5 py-2 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 active:scale-95 text-rose-800 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            <span>Restore Defaults</span>
          </button>

          <button id="btn-run-diagnostics" type="button" class="min-h-[40px] text-xs font-mono font-semibold px-3 py-2 rounded-xl border border-emerald-300 bg-emerald-50/90 hover:bg-emerald-100 active:scale-95 text-emerald-800 transition flex items-center gap-1.5 shadow-2xs" title="Run Interactive Button & Handler Diagnostics">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="diagnostics-badge-label">Self-Test: 100% OK</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Sleek Sticky Compact Progress Header & Snap-Scroll Category Chips (Notch Safe-Area Aware) -->
  <header class="sticky-dashboard sticky sticky-safe-top z-30 bg-sand-50/95 backdrop-blur-md border-b border-slate-200/90 shadow-xs transition-all">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pb-2 pt-1 sm:py-3.5 px-safe">
      <div class="bg-navy-900 text-white rounded-2xl p-3 sm:p-4.5 shadow-md border border-navy-800">
        
        <!-- Compact Status & Progress Count Row -->
        <div class="flex items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-2 min-w-0">
            <span id="status-badge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono uppercase tracking-wider bg-white/10 text-sky-300 shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
              <span id="status-badge-text">Pre-Departure</span>
            </span>
            <span id="total-units-pill" class="text-xs font-mono text-slate-300 hidden sm:inline truncate">
              • 0 total units
            </span>
          </div>

          <div class="flex items-baseline justify-end shrink-0">
            <span id="overall-stats-text" class="font-mono text-xs sm:text-base font-bold text-white tracking-tight">
              0 / 0 packed — 0%
            </span>
          </div>
        </div>

        <!-- Main Animated Progress Track -->
        <div class="w-full h-2.5 sm:h-3.5 bg-navy-950 rounded-full overflow-hidden p-0.5 border border-white/10" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="overall-progress-aria">
          <div id="overall-progress-bar" class="progress-fill h-full rounded-full bg-gradient-to-r from-sky-400 via-teal-400 to-emerald-400" style="width: 0%"></div>
        </div>

        <!-- Horizontally Scrollable Pill Chips on Mobile / 5-Col Grid on Desktop -->
        <div id="header-mini-categories" class="no-scrollbar mt-2.5 pt-2 border-t border-white/10 flex lg:grid lg:grid-cols-5 gap-2 overflow-x-auto snap-x snap-mandatory -mx-1 px-1">
          <!-- Dynamically populated by JS -->
        </div>
      </div>
    </div>
  </header>

  <!-- Main Workspace Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6">

    <!-- Interactive Control Bar: Search, Desktop Filters, Desktop Quick Add (No Print) -->
    <section class="no-print mb-4 sm:mb-6 space-y-3">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-center">
        
        <!-- Desktop Filter Views Segmented Control (On mobile, also mirrored in Thumb-Zone Bar) -->
        <div class="hidden md:flex lg:col-span-5 bg-sand-100 p-1 rounded-xl border border-slate-200/90">
          <button type="button" data-filter="all" class="filter-btn min-h-[40px] flex-1 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 bg-navy-900 text-white shadow-xs active:scale-95">
            <span>All Items</span>
            <span id="count-all" class="font-mono text-[11px] px-1.5 py-0.2 rounded-md bg-white/20">0</span>
          </button>
          <button type="button" data-filter="unpacked" class="filter-btn min-h-[40px] flex-1 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-navy-900 active:scale-95">
            <span>Remaining</span>
            <span id="count-unpacked" class="font-mono text-[11px] px-1.5 py-0.2 rounded-md bg-slate-200/80 text-slate-700">0</span>
          </button>
          <button type="button" data-filter="packed" class="filter-btn min-h-[40px] flex-1 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-navy-900 active:scale-95">
            <span>Packed</span>
            <span id="count-packed" class="font-mono text-[11px] px-1.5 py-0.2 rounded-md bg-slate-200/80 text-slate-700">0</span>
          </button>
        </div>

        <!-- Search Input (16px font on mobile to prevent iOS Safari zoom) -->
        <div class="lg:col-span-4 relative">
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search manifest (passport, reef, camera)..."
            class="w-full min-h-[44px] pl-10 pr-11 py-2.5 bg-white border border-slate-300 rounded-xl text-base sm:text-sm text-navy-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500 transition shadow-2xs"
          />
          <button id="clear-search-btn" type="button" class="hidden absolute right-1.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 w-9 h-9 flex items-center justify-center rounded-lg active:scale-95" title="Clear search">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Desktop Toggle Add Item / Category Drawer Button -->
        <div class="hidden md:flex lg:col-span-3 justify-end gap-2">
          <button id="btn-toggle-add-panel" type="button" class="w-full min-h-[44px] py-2.5 px-4 bg-scarlet-500 hover:bg-scarlet-600 active:scale-95 text-white font-semibold text-sm rounded-xl shadow-xs transition flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Add Item or Category</span>
          </button>
        </div>

      </div>

      <!-- Desktop Expandable Quick-Add Item & New Category Drawer -->
      <div id="add-panel" class="hidden bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-md transition-all">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          <!-- Left: Add New Item to Category -->
          <form id="form-add-item" class="lg:col-span-8 space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-mono uppercase tracking-wider font-bold text-navy-900 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-ocean-500"></span>
                Add Custom Packing Item
              </h3>
              <span class="text-[11px] text-slate-400">Saved automatically</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5">
              <div class="sm:col-span-5">
                <label for="add-item-name" class="sr-only">Item Name</label>
                <input
                  id="add-item-name"
                  type="text"
                  required
                  placeholder="Item name (e.g., Magnetic Cabin Hooks)"
                  class="w-full min-h-[44px] px-3.5 py-2 border border-slate-300 rounded-xl text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-ocean-500"
                />
              </div>
              <div class="sm:col-span-4">
                <label for="add-item-category" class="sr-only">Select Category</label>
                <select
                  id="add-item-category"
                  class="w-full min-h-[44px] px-3 py-2 border border-slate-300 rounded-xl text-base sm:text-sm bg-white focus:outline-none focus:ring-2 focus:ring-ocean-500"
                ></select>
              </div>
              <div class="sm:col-span-3 flex gap-2">
                <div class="w-20 shrink-0">
                  <label for="add-item-qty" class="sr-only">Quantity</label>
                  <input
                    id="add-item-qty"
                    type="number"
                    min="1"
                    max="99"
                    value="1"
                    class="w-full min-h-[44px] px-2.5 py-2 border border-slate-300 rounded-xl text-base sm:text-sm font-mono text-center focus:outline-none focus:ring-2 focus:ring-ocean-500"
                    title="Quantity"
                  />
                </div>
                <button type="submit" class="flex-1 min-h-[44px] bg-navy-900 hover:bg-navy-800 active:scale-95 text-white font-semibold text-sm px-3 py-2 rounded-xl transition">
                  Add
                </button>
              </div>
